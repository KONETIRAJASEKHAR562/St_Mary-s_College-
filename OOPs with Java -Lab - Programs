Lab - 4:            Title : File Handling & It's Operation's
                    Aim: Write a Java program on Random Access File class to perform different read and write
                    operations.
                    
                    Requirements/Objectives:  PC/ Laptop, ByteXL/eclipse IDE/ IntelliJ IDE (new bean platform), Network.
                    Solution:
                    Source Code:
                    import java.io.*;
                    import java.util.Scanner;
                    public class Lab4 {
                        public static void main(String[] args) {
                            Scanner sc = new Scanner(System.in);
                            System.out.print("Enter file name: ");
                            String filename = sc.nextLine();
                            try (RandomAccessFile raf = new RandomAccessFile(filename, "rw")) {
                                //User inputs
                                System.out.print("Enter an integer: ");
                                int userInt =sc.nextInt();
                                System.out.print("Enter a double: ");
                                double userDouble =sc.nextDouble();
                                sc.nextLine(); //consume newline
                                System.out.print("Enter a string: ");
                                String userString =sc.nextLine();
                                //Write data
                                raf.writeInt(userInt);
                                raf.writeDouble(userDouble);
                                raf.writeUTF(userString);
                                //Move pointer to start
                                raf.seek(0);
                                //Read data
                                int i =raf.readInt();
                                double d =raf.readDouble();
                                String str =raf.readUTF();
                                System.out.println("\nRead Int: "+i);
                                System.out.println("Read Double: "+d);
                                System.out.println("Read String: "+str);
                                //modify int at start
                                System.out.print("\nEnter new integer to overwrite first value: ");
                                int newInt = sc.nextInt();
                                raf.seek(0);
                                raf.writeInt(newInt);
                                raf.seek(0);
                                int modifiedInt =raf.readInt();
                                System.out.println("Modified Int: "+modifiedInt);
                                sc.nextLine(); //consume newline
                                //Append string
                                System.out.print("\nEnter string to append: ");
                                String appendText = sc.nextLine();
                                raf.seek(raf.length());
                                raf.writeUTF(appendText);
                                // Read appended string
                                long pos = raf.length()-(appendText.length()+2);
                                raf.seek(pos);
                                String appendedStr =raf.readUTF();
                                System.out.println("Appended String: "+appendedStr);
                            } catch (IOException e) {
                                System.out.println("I/O error: "+e.getMessage());
                            }
                            sc.close();
                        }
                    }
